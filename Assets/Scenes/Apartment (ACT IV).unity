    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 5034393123944484073, guid: 92051cbd2f68bc14bad6d5deabfd1bfa, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5034393123944484073, guid: 92051cbd2f68bc14bad6d5deabfd1bfa, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: '"Finally back home... that shift dragged on forever."'
      objectReference: {fileID: 0}
    - target: {fileID: 5034393123944484073, guid: 92051cbd2f68bc14bad6d5deabfd1bfa, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "\"I still can\u2019t believe that hobo tried to scare me\u2026 what
        a freak.\""
      objectReference: {fileID: 0}
    - target: {fileID: 5034393123944484073, guid: 92051cbd2f68bc14bad6d5deabfd1bfa, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "\"Huh? I swore I closed the window before I left\u2026 must\u2019ve
        forgotten.\""
      objectReference: {fileID: 0}
    - target: {fileID: 5034393123944484073, guid: 92051cbd2f68bc14bad6d5deabfd1bfa, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "\"Whatever. Just one last order of business tonight \u2014 sleep.\""
      objectReference: {fileID: 0}
